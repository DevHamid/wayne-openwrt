 static struct pd_map *pd_maps;
+static int trace_queries;
+static unsigned int trace_count;
+
+/* Fixed labels only: never export an arbitrary request or response body. */
+static void trace_query(const struct qrtr_packet *pkt, const char *label,
+                        unsigned int domains, unsigned int result,
+                        unsigned int error, const char *status)
+{
+	struct timespec now;
+	if (!trace_queries) return;
+	if (trace_count >= 64) {
+		if (trace_count == 64) {
+			fputs("mapper_trace limit=64 further_records=suppressed\n", stderr);
+			trace_count++;
+		}
+		return;
+	}
+	trace_count++;
+	if (clock_gettime(CLOCK_MONOTONIC, &now) < 0) {
+		fprintf(stderr, "mapper_trace seq=%u clock=error\n", trace_count);
+		return;
+	}
+	fprintf(stderr, "mapper_trace seq=%u mono_s=%lld mono_ns=%ld "
+	        "service=%s src_node=%u src_port=%u domains=%u "
+	        "result=%u error=%u send=%s\n", trace_count,
+	        (long long)now.tv_sec, now.tv_nsec, label, pkt->node, pkt->port,
+	        domains, result, error, status);
+}
 
