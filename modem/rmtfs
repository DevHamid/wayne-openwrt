#!/bin/sh /etc/rc.common
# Wayne diagnostic rmtfs service. Never write EFS/calibration partitions.
USE_PROCD=1
START=95
STOP=10
EXTRA_COMMANDS="diagnose"
EXTRA_HELP="diagnose Show firmware, backing, and shared-memory state"

RMTFS_BIN=/usr/bin/rmtfs
RMTFS_ROOT=/tmp/wayne-rmtfs
RMTFS_UIO_DEV=/dev/qcom_rmtfs_uio1
FIRMWARE_MOUNT=
FIRMWARE_DIR=

log() { logger -t rmtfs "$*"; }

find_partition() {
	local p name dev
	for p in /sys/class/block/mmcblk0p*/uevent; do
		[ -r "$p" ] || continue
		name=$(sed -n 's/^PARTNAME=//p' "$p")
		[ "$name" = "$1" ] || continue
		dev=$(sed -n 's/^DEVNAME=//p' "$p")
		[ -b "/dev/$dev" ] || continue
		printf '%s\n' "/dev/$dev"
		return 0
	done
	return 1
}

find_uio() {
	local uio
	for uio in /sys/class/uio/uio*; do
		[ -r "$uio/name" ] || continue
		[ "$(cat "$uio/name")" = rmtfs ] || continue
		[ -c "/dev/${uio##*/}" ] || continue
		printf '%s\n' "/dev/${uio##*/}"
		return 0
	done
	return 1
}

mount_firmware() {
	local dev target rest part src
	part=$(find_partition modem) || { log 'PARTNAME=modem not found'; return 1; }
	# Reuse the automounter's existing mount. Do not remount or unmount it.
	while read -r dev target rest; do
		[ "$(readlink -f "$dev")" = "$part" ] || continue
		FIRMWARE_MOUNT=$target
		break
	done < /proc/mounts
	if [ -z "$FIRMWARE_MOUNT" ]; then
		FIRMWARE_MOUNT=/mnt/wayne-modem-firmware
		mkdir -p "$FIRMWARE_MOUNT" || return 1
		mount -t vfat -o ro "$part" "$FIRMWARE_MOUNT" || return 1
	fi
	# Stock Wayne firmware lives in image/, not the VFAT root.
	for src in "$FIRMWARE_MOUNT/image" "$FIRMWARE_MOUNT"; do
		if [ -f "$src/modem.mdt" ] || [ -f "$src/MODEM.MDT" ]; then
			FIRMWARE_DIR=$src
			return 0
		fi
	done
	log "modem.mdt absent from $FIRMWARE_MOUNT/image and mount root"
	return 1
}

wire_firmware() {
	local src name lower dest
	mkdir -p /lib/firmware || return 1
	for src in "$FIRMWARE_DIR"/*; do
		[ -f "$src" ] || continue
		name=${src##*/}
		lower=$(printf '%s' "$name" | tr 'A-Z' 'a-z')
		case "$lower" in mba.mbn|mba.b00|modem.mdt|modem.b[0-9a-f][0-9a-f]) ;;
			*) continue ;;
		esac
		dest=/lib/firmware/$lower
		# Preserve valid firmware already shipped in a read-only ROM rootfs.
		[ -r "$dest" ] || ln -s "$src" "$dest" || return 1
	done
	[ -r /lib/firmware/mba.mbn ] && [ -r /lib/firmware/modem.mdt ] &&
		[ -r /lib/firmware/modem.b00 ]
}

prepare_backing() {
	local label part
	mkdir -p "$RMTFS_ROOT" || return 1
	for label in modemst1 modemst2 fsg fsc; do
		part=$(find_partition "$label") || { log "missing PARTNAME=$label"; return 1; }
		# Directory entries only. rmtfs -r opens backing O_RDONLY and shadows
		# modem writes in RAM; never remove -r for a bring-up test.
		ln -snf "$part" "$RMTFS_ROOT/$label" || return 1
	done
}

start_service() {
	local uio
	mount_firmware || return 1
	wire_firmware || { log 'firmware wiring failed'; return 1; }
	prepare_backing || return 1
	uio=$(find_uio) || { log 'rmtfs UIO character device not found'; return 1; }
	[ -x "$RMTFS_BIN" ] || { log "$RMTFS_BIN missing"; return 1; }
	ln -snf "$uio" "$RMTFS_UIO_DEV" || return 1
	procd_open_instance
	procd_set_param command "$RMTFS_BIN" -r -P -o "$RMTFS_ROOT" -v
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
	log "registered daemon: UIO=$uio firmware=$FIRMWARE_DIR backing=READ-ONLY"
}

diagnose() {
	printf 'UIO: %s\n' "$(find_uio)"
	ls -l "$RMTFS_ROOT" "$RMTFS_UIO_DEV" /lib/firmware/mba.mbn /lib/firmware/modem.mdt 2>/dev/null
	cat /sys/class/modem-boot/modem0/state 2>/dev/null
}
