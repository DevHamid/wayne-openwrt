#!/bin/sh /etc/rc.common
# TFTP-over-QRTR server: the modem writes server_check.txt and reads
# firmware side files here. Required by the WLAN domain.
USE_PROCD=1
START=96
STOP=10
start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/tqftpserv
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
