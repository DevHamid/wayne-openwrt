#!/bin/sh /etc/rc.common
# Watches the modem subsystem state and re-announces the AP-side QRTR
# services on every modem ONLINE transition. See usr/lib/wayne/qrefresh.sh.
USE_PROCD=1
START=99
STOP=5
start_service() {
	procd_open_instance
	procd_set_param command /bin/sh /usr/lib/wayne/qrefresh.sh
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
