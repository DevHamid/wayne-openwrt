#!/bin/sh /etc/rc.common
# burnin-guard: blank the panel + kill backlight after BOOT_IDLE seconds, then
# KEEP re-asserting it (a one-shot write loses the race with the panel driver).
# Stops burn-in while the phone sits on the MI/fastboot logo during bring-up.
#
# WHY PROCD: v0.9.7 ran `screen.sh guard 90 &` from start(). That backgrounded
# daemon is a child of the rc script, and procd reaps the script's process
# group once start() returns -- so the guard was killed almost immediately and
# the screen never went off ("screen doesn't turn off automatically"). procd
# supervision keeps it alive AND restarts it if it ever dies.
#
# Manual override any time:  sh /root/screen.sh on   |   /etc/init.d/burnin-guard stop
START=99
STOP=10
USE_PROCD=1
BOOT_IDLE=90

start_service() {
    [ -x /root/screen.sh ] || return 0
    procd_open_instance
    procd_set_param command /root/screen.sh guardfg "$BOOT_IDLE"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    [ -x /root/screen.sh ] || return 0
    /root/screen.sh stop >/dev/null 2>&1
}
