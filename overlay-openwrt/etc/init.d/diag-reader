#!/bin/sh /etc/rc.common
# Modem DIAG consumer. The modem firmware's diag task starves
# ("dog_hb: Task starvation: diag") when nothing on the AP reads /dev/diag:
# the kernel diag buffers fill, flow control blocks the modem's diag task,
# and the modem ERR_FATALs. The stock Android build keeps qcrild holding
# /dev/diag open for the whole boot; this service does the same job.
#
# Why not `cat /dev/diag`?  A bare `cat` worked on the adios-wayne kernel,
# but the v2 (LKGeek) kernel's diagchar driver refuses a raw read until the
# message/log masks are negotiated: `diag_copy_to_user_msg_mask ... err -22`
# (EINVAL). cat does no ioctl, so it can never satisfy the handshake and the
# drain silently does nothing. wayne-diagd (tools/wayne-diagd.c) performs the
# DIAG_IOCTL handshake (REMOTE_DEV / SWITCH_LOGGING / COMMAND_REG) like
# Android's qcrild, then drains forever. Falls back to `cat` if the binary
# is missing so the anti-starvation hold is never lost.
USE_PROCD=1
START=25
STOP=90

DIAGD=/usr/lib/wayne/wayne-diagd

diag_cmd() {
	if [ -x "$DIAGD" ]; then
		echo "$DIAGD"
	else
		# Fallback: best-effort raw drain (adios-kernel behaviour). Logs a
		# warning so we notice when the handshake binary is absent.
		logger -t diag-reader "wayne-diagd missing at $DIAGD; falling back to cat (no msg-mask handshake)"
		echo '/bin/sh -c "cat /dev/diag > /dev/null 2>&1"'
	fi
}

start_service() {
	procd_open_instance
	procd_set_param command $(diag_cmd)
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
