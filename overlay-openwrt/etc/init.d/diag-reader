#!/bin/sh /etc/rc.common
# Modem DIAG consumer. The modem firmware's diag task starves
# ("dog_hb: Task starvation: diag") when nothing on the AP reads /dev/diag:
# the kernel diag buffers fill, flow control blocks the modem's diag task,
# and the modem ERR_FATALs. The stock Android build keeps qcrild holding
# /dev/diag open for the whole boot; this service does the same job.
USE_PROCD=1
START=25
STOP=90
start_service() {
	procd_open_instance
	procd_set_param command /bin/sh -c "cat /dev/diag > /dev/null 2>&1"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
