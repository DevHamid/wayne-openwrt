#!/bin/sh /etc/rc.common
# Materialize the WLAN firmware where tqftpserv serves it from.
# The boot partition cannot carry the firmware (~24 MiB), so it is
# taken from the device's own vendor firmware partition at boot.
# The daemon resolves /readonly/firmware/image/* requests against the
# firmware base (/lib/firmware) on platforms without remoteproc, so the
# files are staged there as well.
START=95
STOP=10

boot_wlan_fw() {
	local src=/mnt/mmcblk0p56
	local dst=/lib/firmware
	local alt=/readonly/firmware/image

	if [ ! -d "$src/image" ]; then
		mkdir -p "$src"
		mount -o ro /dev/mmcblk0p56 "$src" 2>/dev/null
	fi
	[ -d "$src/image" ] || return 1

	mkdir -p "$dst" "$alt" /readonly/vendor/firmware
	for f in "$src"/image/wlanmdsp.mbn "$src"/image/bdwlan.*; do
		[ -e "$f" ] || continue
		b=$(basename "$f")
		cp "$f" "$dst/$b"
		cp "$f" "$alt/$b"
		cp "$f" "/readonly/vendor/firmware/$b"
	done
	return 0
}

start() {
	boot_wlan_fw
	logger -t wayne-wlan-fw "wlan firmware staged: $(ls /lib/firmware/wlanmdsp.mbn /lib/firmware/bdwlan.* 2>/dev/null | wc -l) files"
}
