#!/bin/sh /etc/rc.common
# Userspace QRTR nameserver: this 4.19 CAF kernel has no in-kernel NS.
# Serves qrtr-lookup diagnostics; services reach the modem via
# announcements, so this is diagnostics-only.
USE_PROCD=1
START=11
STOP=90
start_service() {
	procd_open_instance
	procd_set_param command /usr/lib/wayne/radio/qrtr-ns -f
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
