#!/bin/sh /etc/rc.common
# wayne-wlan -- load the qcacld WLAN stack once the modem/WPSS is up.
#
# The WLAN domain is a subdomain of the MODEM (wlan_pd): Wi-Fi rides the modem's
# QRTR/QMI transport and the WLFW service (id 69) only appears once the modem PD
# is online. qcacld is therefore built as a module (CONFIG_QCA_CLD_WLAN=m) and
# loaded here, AFTER modem-boot-trigger (START=97), so its one-shot probe runs
# with FW-ready already true. Nothing else in the image loads wlan.ko.
#
# ORDER: rmtfs(95) -> wayne-wlan-fw(95) -> pd-mapper/tqftpserv(96)
#        -> modem-boot-trigger(97) -> wayne-wlan(99)
#
# Disable with:  uci set wayne-wlan.main.autoload=0 && uci commit wayne-wlan
USE_PROCD=1
START=99
STOP=05

start_service() {
    [ "$(uci -q get wayne-wlan.main.autoload)" = 0 ] && return 0
    procd_open_instance
    procd_set_param command /bin/sh /usr/lib/wayne/wlan-load.sh
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
