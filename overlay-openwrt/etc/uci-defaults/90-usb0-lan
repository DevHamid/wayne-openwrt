#!/bin/sh
# /etc/uci-defaults/90-usb0-lan -- runs once on first boot, then deletes itself.
#
# Goal: the USB ECM gadget (usb0) becomes the device's only network interface,
# with a static gateway IP, a DHCP server for the host PC, and dropbear+uhttpd
# reachable on it.
#
# WHY STANDALONE AND NOT A BRIDGE (2026-11-07):
#   This device has exactly one net interface (usb0) and no eth0. An earlier
#   version tried to bridge usb0 into br-lan; netifd created the UCI sections
#   correctly (ports='usb0') but never instantiated the device -- ifstatus
#   reported NO_DEVICE and the log never mentioned 'lan' at all. Rather than
#   debug netifd's bridge handling on a vendor 4.19 tree, drop the bridge:
#   a standalone static usb0 interface is what actually came up and worked.
#
# Boot order (ImmortalWrt 23.05, /etc/init.d/boot START=10):
#   /bin/config_generate  -> creates network.lan + a br-lan device (ports=eth0)
#   uci_apply_defaults    -> runs THIS script; both sections already exist
# So this script DELETES the useless lan/bridge sections and builds usb0 fresh.

# --- 1. Remove the eth0-based lan + bridge (useless here, and its presence
#        makes netifd try to bring up a bridge that never materialises). ---
uci -q delete network.lan
i=0
while [ $i -lt 16 ]; do
    name=$(uci -q get network.@device[$i].name 2>/dev/null)
    if [ "$name" = "br-lan" ]; then
        uci -q delete network.@device[$i]
        continue    # indices shift down after a delete; re-check same index
    fi
    i=$((i+1))
done

# --- 2. Standalone usb0 interface: static gateway IP. ---
uci -q delete network.usb0
uci set network.usb0=interface
uci set network.usb0.device='usb0'
uci set network.usb0.proto='static'
uci set network.usb0.ipaddr='192.168.1.1'
uci set network.usb0.netmask='255.255.255.0'
uci commit network

# --- 3. DHCP server on usb0 so the host PC auto-gets 192.168.1.x. ---
uci -q delete dhcp.lan
uci -q delete dhcp.usb0
uci set dhcp.usb0=dhcp
uci set dhcp.usb0.interface='usb0'
uci set dhcp.usb0.start='100'
uci set dhcp.usb0.limit='150'
uci set dhcp.usb0.leasetime='12h'
uci commit dhcp

# --- 4. dropbear: no per-interface filter, listen everywhere. ---
uci -q delete dropbear.@dropbear[0].Interface
uci commit dropbear

# --- 5. Firewall: put usb0 in the lan zone so input isn't dropped. ---
if uci -q get firewall.@zone[0].network >/dev/null 2>&1; then
    uci -q delete firewall.@zone[0].network
    uci add_list firewall.@zone[0].network='usb0'
    uci commit firewall
fi

/etc/init.d/network restart >/dev/null 2>&1
/etc/init.d/dnsmasq restart >/dev/null 2>&1
/etc/init.d/dropbear restart >/dev/null 2>&1
/etc/init.d/firewall restart >/dev/null 2>&1

exit 0
