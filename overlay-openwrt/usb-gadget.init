#!/bin/sh /etc/rc.common
# /etc/init.d/usb-gadget -- build the wayne composite USB gadget (acm + ecm)
# on the PERSISTENT OpenWrt rootfs (p64). The initramfs /init builds the gadget
# for the installer/debug images; after switch_root to /sbin/init (procd) there
# is no /init of ours, so this service does the same job for the real system.
#
# Result: acm.usb0 -> /dev/ttyGS0 (serial console), ecm.usb0 -> usb0 (ethernet).
# Needed because CONFIG_USB_G_SERIAL is gone (M5): nothing auto-binds the UDC.
#
# NETWORK MODEL (2026-11-07): usb0 is a STANDALONE static interface at
# 192.168.1.1/24. No bridge -- this device has no eth0, and netifd on this
# vendor 4.19 tree never instantiated the br-lan device (ifstatus: NO_DEVICE).
# The uci-defaults script 90-usb0-lan sets this up on first boot; this service
# only re-asserts it if the config is missing (e.g. a rootfs that predates it).

START=95
STOP=10
USE_PROCD=1

# Make usb0 a first-class UCI interface: static IP + DHCP server.
ensure_usb0_uci() {
    if ! uci -q get network.usb0 >/dev/null; then
        uci set network.usb0=interface
        uci set network.usb0.proto='static'
        uci set network.usb0.device='usb0'
        uci set network.usb0.ipaddr='192.168.1.1'
        uci set network.usb0.netmask='255.255.255.0'
        uci commit network
        logger -t usb-gadget "created network.usb0 (static 192.168.1.1/24)"
    fi
    if ! uci -q get dhcp.usb0 >/dev/null; then
        uci set dhcp.usb0=dhcp
        uci set dhcp.usb0.interface='usb0'
        uci set dhcp.usb0.start='100'
        uci set dhcp.usb0.limit='150'
        uci set dhcp.usb0.leasetime='12h'
        uci commit dhcp
        logger -t usb-gadget "created dhcp.usb0 (DHCP 192.168.1.100+)"
    fi
    # dropbear: duplicate Interface entries kill the listener. Normalize to
    # a single usb0 entry every boot (delete then add once).
    uci -q delete dropbear.@dropbear[0].Interface
    uci add_list dropbear.@dropbear[0].Interface='usb0'
    uci commit dropbear
    logger -t usb-gadget "dropbear: Interface normalized to single usb0"
    /etc/init.d/network reload 2>/dev/null
    /etc/init.d/dnsmasq restart 2>/dev/null
    /etc/init.d/dropbear restart 2>/dev/null
}

start_service() {
    # The gadget builder lives either at /usr/lib/wayne/usb-gadget.sh
    # (persistent layout) or at /usb-gadget.sh (initramfs/legacy layout).
    # Source whichever exists so procd always builds the USB gadget.
    if [ -r /usr/lib/wayne/usb-gadget.sh ]; then
        . /usr/lib/wayne/usb-gadget.sh
    elif [ -r /usb-gadget.sh ]; then
        . /usb-gadget.sh
    fi
    type usb_gadget_up >/dev/null 2>&1 || { logger -t usb-gadget "usb_gadget_up not found"; return 0; }
    usb_gadget_up
    [ -e /sys/class/net/usb0 ] || return 0

    ip link set usb0 up 2>/dev/null
    # usb0 is standalone (no bridge). Re-assert the UCI config if missing.
    ensure_usb0_uci
    logger -t usb-gadget "usb0 standalone 192.168.1.1/24 (UCI)"
    return 0
}
