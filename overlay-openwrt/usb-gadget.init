#!/bin/sh /etc/rc.common
# /etc/init.d/usb-gadget -- build the wayne composite USB gadget (acm + rndis)
# on the PERSISTENT OpenWrt rootfs (p64). The initramfs /init builds the gadget
# for the installer/debug images; after switch_root to /sbin/init (procd) there
# is no /init of ours, so this service does the same job for the real system.
#
# Result: acm.usb0 -> /dev/ttyGS0 (serial console), rndis.usb0 -> usb0 (ethernet).
# Needed because CONFIG_USB_G_SERIAL is gone (M5): nothing auto-binds the UDC.

START=95
STOP=10
USE_PROCD=1

start_service() {
    [ -r /usr/lib/wayne/usb-gadget.sh ] && . /usr/lib/wayne/usb-gadget.sh
    type usb_gadget_up >/dev/null 2>&1 || return 0
    usb_gadget_up
    [ -e /sys/class/net/usb0 ] || return 0

    ip link set usb0 up 2>/dev/null
    # Preferred: join br-lan. dnsmasq then serves DHCP and dropbear (Interface
    # 'lan') is already listening -- the PC just runs `ssh root@192.168.1.1`.
    if ip link set usb0 master br-lan 2>/dev/null; then
        logger -t usb-gadget "usb0 bridged into br-lan"
        return 0
    fi
    # Fallback: standalone static address, and make dropbear listen on it.
    ip addr add 192.168.42.1/24 dev usb0 2>/dev/null
    uci -q add_list dropbear.@dropbear[0].Interface='usb0' && uci -q commit dropbear
    /etc/init.d/dropbear reload 2>/dev/null
    logger -t usb-gadget "usb0 standalone 192.168.42.1/24"
    return 0
}
