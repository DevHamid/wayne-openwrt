#!/bin/busybox-static sh
# /init -- the very first program the kernel runs (PID 1) from the initramfs.
#
# SHEBANG NOTE: we hardcode /bin/busybox-static (the static binary we inject)
# instead of /bin/sh. OpenWrt's /bin/sh is a symlink to its *dynamic* busybox,
# which needs the musl loader. If that chain ever fails, the kernel panics with
# "Requested init /init failed" with no output at all. A static shell cannot
# fail that way -- it has zero library dependencies.
#
# WHY THIS FILE EXISTS:
#   The kernel, after decompressing an initramfs, looks for exactly one file
#   named /init and executes it. OpenWrt's own first program is /sbin/init
#   (procd), but the kernel does not know to look there. This tiny wrapper
#   does the minimum setup the kernel cannot do itself, then hands control
#   to OpenWrt. Everything else is OpenWrt's job.
#
# Serial console + USB ethernet: ONE configfs composite gadget (acm + rndis),
# built by overlay-common/usb-gadget.sh, which we source below.
#  - acm.usb0   -> /dev/ttyGS0  (serial console -> PC /dev/ttyACM0)
#  - rndis.usb0 -> usb0         (USB ethernet  -> SSH)
# CONFIG_USB_G_SERIAL is NOT set (M5 finding): the legacy g_serial grabbed the
# single UDC at boot and blocked any configfs gadget with "Resource busy".

# --- 1. Mount the basics ------------------------------------------------
mount -t devtmpfs devtmpfs /dev      2>/dev/null
mount -t proc     proc     /proc
mount -t sysfs    sysfs    /sys
mount -t devpts   devpts   /dev/pts  2>/dev/null

[ -e /dev/console ] || mknod -m 600 /dev/console c 5 1
[ -e /dev/null    ] || mknod -m 666 /dev/null    c 1 3

echo "initramfs: /init reached PID 1"

# --- 2. Bring up the composite USB gadget (console + ethernet) -----------
# Nothing binds the UDC for us any more: g_serial is gone, so WE build the
# gadget here. acm.usb0 gives /dev/ttyGS0 (console); rndis.usb0 gives usb0.
if [ -r /usb-gadget.sh ]; then
    . /usb-gadget.sh
    if usb_gadget_up; then
        echo "initramfs: USB gadget up (/dev/ttyGS0 + usb0)" > /dev/ttyGS0
    else
        echo "initramfs: WARNING -- usb_gadget_up failed (continuing)"
    fi
else
    echo "initramfs: WARNING -- /usb-gadget.sh missing (no console, no usb0)"
fi

echo "initramfs: handing over to OpenWrt /sbin/init"

# --- 3. Hand over ----------------------------------------------------------
# exec replaces this shell with procd, so procd becomes PID 1. No switch_root:
# in an initramfs boot, the filesystem we are on IS the real root.
exec /sbin/init

# If exec failed (missing or wrong-architecture /sbin/init) we land here.
# PID 1 must never exit (kernel panics on init death), so respawn the shell.
echo "initramfs: FATAL -- /sbin/init did not start, dropping to shell"
while true; do
    /bin/sh
    echo "(shell exited -- respawning; PID 1 must not die)"
done
