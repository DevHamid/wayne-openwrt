#!/bin/busybox-static sh
# /init for the INSTALLER image (v0.9.4 -- debug/robust build).
#
# v0.9 SYMPTOM: `fastboot boot installer-boot.img` -> stuck at Mi logo, no
# ttyACM0, phone reboots to Android. `openwrt-boot.img` and `donor-control.img`
# boot to ttyACM0 fine.
#
# EVIDENCE: the two ramdisks differ by 636 B (6,907,814 working vs 6,908,450
# failing) = exactly the init-script size delta. Kernel bytes identical, donor
# cmdline verbatim (312 chars, no root=), same rootfs. So the ONLY functional
# difference is this file -- meaning /init itself dies at RUNTIME on-device,
# before a single byte can be seen. The file is clean on disk (sh -n OK, no
# CRLF, no non-ASCII), so it is not corruption: it is behaviour.
#
# v0.9.4 removes every way that death can be silent:
#   1. NO `exec >/dev/console`. v0.9 had it (line 39). If that redirect fails,
#      a non-interactive POSIX shell EXITS -> PID 1 dies -> vendor kernel
#      panics -> reboot to Android with no output. The working openwrt /init
#      never does this redirect. This is the prime suspect.
#   2. Every message is mirrored to /dev/console AND /dev/ttyGS0 AND a log file,
#      never redirected away.
#   3. Every step is timestamped, so we see exactly where it stops.
#   4. An EXIT/INT/TERM trap: no path can kill PID 1. Any failure respawns a
#      rescue shell on the USB serial port instead of panicking.
#   5. If legacy g_serial never binds, bind configfs f_acm as a console fallback.
#   6. A 3 s "plug in now" pause before anything happens.
#
# Install logic and its 5 guards are UNCHANGED from v0.9. Only observability
# and the failure paths changed.

TARGET=/dev/mmcblk0p64
MNT=/mnt/target
MARKER=.wayne-openwrt-root
LOG=/tmp/installer.log

# --- 1. basics -------------------------------------------------------------
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mount -t proc     proc     /proc
mount -t sysfs    sysfs    /sys
mount -t devpts   devpts   /dev/pts 2>/dev/null
mount -t tmpfs    tmpfs    /tmp 2>/dev/null
[ -e /dev/console ] || mknod -m 600 /dev/console c 5 1
[ -e /dev/null ]    || mknod -m 666 /dev/null    c 1 3

say() {
    _t=$(date -u +%H:%M:%S 2>/dev/null)
    _l="installer[${_t:-?}]: $*"
    echo "$_l" >> "$LOG" 2>/dev/null
    echo "$_l" > /dev/console 2>/dev/null
    [ -e /dev/ttyGS0 ] && echo "$_l" > /dev/ttyGS0 2>/dev/null
    return 0
}

rescue_shell() {
    say "RESCUE: dropping to a shell (ttyGS0 first, console second)"
    while true; do
        if [ -e /dev/ttyGS0 ]; then
            /bin/sh < /dev/ttyGS0 > /dev/ttyGS0 2>&1
        else
            /bin/sh < /dev/console > /dev/console 2>&1
        fi
        say "(shell exited -- respawning; PID 1 must not die)"
        sleep 1
    done
}

fatal() { say "FATAL -- $*"; say "NOTHING WRITTEN"; rescue_shell; }

# Any unexpected exit (including a redirect failure that kills the shell) lands
# here instead of panicking the kernel.
trap 'say "TRAP: script exiting (status $?); respawning instead of dying"; rescue_shell' EXIT INT TERM

say "=== wayne installer initramfs v0.9.4 -- PID 1 alive ==="
say "no exec >/dev/console: output is mirrored, never redirected"

# --- 2. let a human attach the cable and open the port ---------------------
say "plug the phone into the PC NOW; 3s pause before any work"
sleep 3

# --- 3. serial console -----------------------------------------------------
n=0; while [ ! -e /dev/ttyGS0 ] && [ $n -lt 15 ]; do sleep 1; n=$((n+1)); done
if [ ! -e /dev/ttyGS0 ]; then
    say "no /dev/ttyGS0 after 15s -- trying configfs f_acm fallback"
    G=/sys/kernel/config/usb_gadget/g1
    mkdir -p "$G" 2>/dev/null
    echo 0x1d6b > "$G/idVendor"  2>/dev/null
    echo 0x0104 > "$G/idProduct" 2>/dev/null
    mkdir -p "$G/strings/0x409" 2>/dev/null
    echo wayne     > "$G/strings/0x409/serialnumber" 2>/dev/null
    echo wayne     > "$G/strings/0x409/manufacturer" 2>/dev/null
    echo installer > "$G/strings/0x409/product"      2>/dev/null
    mkdir -p "$G/configs/c.1/strings/0x409" 2>/dev/null
    echo acm > "$G/configs/c.1/strings/0x409/configuration" 2>/dev/null
    mkdir -p "$G/functions/acm.usb0" 2>/dev/null
    ln -s "$G/functions/acm.usb0" "$G/configs/c.1/" 2>/dev/null
    UDC=$(ls /sys/class/udc/ 2>/dev/null | head -1)
    [ -n "$UDC" ] && echo "$UDC" > "$G/UDC" 2>/dev/null
    n=0; while [ ! -e /dev/ttyGS0 ] && [ $n -lt 10 ]; do sleep 1; n=$((n+1)); done
fi
if [ -e /dev/ttyGS0 ]; then
    say "USB serial ready (/dev/ttyGS0 -> PC /dev/ttyACM0)"
    # No cttyhack/setsid in OpenWrt's busybox: plain background-respawn shell.
    ( while true; do /bin/sh < /dev/ttyGS0 > /dev/ttyGS0 2>&1; sleep 1; done ) &
else
    say "WARNING: still no /dev/ttyGS0 -- console output only"
fi

# --- 4. read target facts --------------------------------------------------
say "reading target facts"
SECT=$(cat /sys/class/block/$(basename $TARGET)/size 2>/dev/null)
NAME=$(cat /sys/class/block/$(basename $TARGET)/uevent 2>/dev/null | sed -n 's/^PARTNAME=//p')
GIB=$(( ${SECT:-0} / 2 / 1024 / 1024 ))
say "target=$TARGET name=${NAME:-<unknown>} size=${GIB}GiB"

# --- 5. GUARDS -------------------------------------------------------------
[ -b "$TARGET" ]         || fatal "$TARGET is not a block device"
[ -n "$SECT" ]           || fatal "cannot read $TARGET size"
[ "$GIB" -ge 8 ]         || fatal "$TARGET is only ${GIB} GiB -- refusing"
[ "$NAME" = "userdata" ] || fatal "$TARGET PARTNAME is '$NAME', expected 'userdata'"
say "all guards passed"

# --- 6. marker: install at most once --------------------------------------
mkdir -p "$MNT"
ALREADY=0
if mount -t ext4 "$TARGET" "$MNT" 2>/dev/null; then
    if [ -f "$MNT/$MARKER" ]; then
        say "marker found -- rootfs already installed; skipping install"
        ALREADY=1
    else
        say "ext4 with no marker -- will reinstall (not our rootfs)"
        umount "$MNT"
    fi
else
    say "target not mountable as ext4 -- will format"
fi

# --- 7. install ------------------------------------------------------------
if [ "$ALREADY" != "1" ]; then
    say "*** FORMATTING $TARGET ($NAME) ext4. Android data on it is lost. ***"
    /usr/sbin/mkfs.ext4 -F -L wayne-root "$TARGET" || fatal "mkfs.ext4 failed"
    say "mkfs done; mounting target"
    mount -t ext4 "$TARGET" "$MNT" || fatal "mount of formatted target failed"

    say "copying live rootfs -> $MNT (this is the only source of the OS)"
    cat > /tmp/exclude.list <<'EXCL'
./proc
./sys
./dev
./tmp
./mnt
./init
./rom
EXCL
    tar -cf - -C / -X /tmp/exclude.list . | tar -xf - -C "$MNT" || fatal "rootfs copy failed"
    say "copy done; verifying"

    [ -e "$MNT/sbin/init" ] || fatal "copied rootfs has no /sbin/init"
    [ -e "$MNT/bin/sh" ]    || ln -sf busybox "$MNT/bin/sh"

    date > "$MNT/$MARKER" 2>/dev/null || echo installed > "$MNT/$MARKER"
    sync
    say "install complete -- marker written"
fi

# --- 8. hand off -----------------------------------------------------------
say "preparing switch_root"
mkdir -p "$MNT/dev" "$MNT/proc" "$MNT/sys" "$MNT/tmp"
mount --move /dev  "$MNT/dev"  2>/dev/null
mount --move /proc "$MNT/proc" 2>/dev/null
mount --move /sys  "$MNT/sys"  2>/dev/null
mount --move /tmp  "$MNT/tmp"  2>/dev/null

say "exec switch_root -> $MNT /sbin/init"
exec switch_root "$MNT" /sbin/init
fatal "switch_root returned -- /sbin/init did not start"
