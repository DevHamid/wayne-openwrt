#!/bin/busybox-static sh
# /init -- M9 SYSTEM bootstrap (kernel on boot, OS on system, like Android).
#
# This replaces the OS-carrying initramfs. The boot partition now holds ONLY
# the kernel (14.9MB) plus this tiny static bootstrap. It does one job:
#   mount the system partition (p61) read-only, then switch_root into it.
# OpenWrt's procd (/sbin/init) then owns the real root. Writable config/
# packages live on /overlay -> userdata (p64) via the rootfs fstab.
#
# Why NOT root= on the cmdline: pack-boot-root.py's appended root= made the
# kernel try to mount the target as root BEFORE /init ran, and it panicked
# (v0.9.4). The donor cmdline is preserved verbatim; /init does the mount.
#
# Why static busybox: OpenWrt's /bin/sh is a symlink to its *dynamic* busybox
# needing the musl loader. If that chain fails before switch_root the kernel
# panics "Requested init /init failed" with no output. A static shell cannot.

mount -t devtmpfs devtmpfs /dev      2>/dev/null
mount -t proc     proc     /proc
mount -t sysfs    sysfs    /sys
mount -t devpts   devpts   /dev/pts  2>/dev/null
mount -t tmpfs    tmpfs    /tmp       2>/dev/null

[ -e /dev/console ] || mknod -m 600 /dev/console c 5 1
[ -e /dev/null    ] || mknod -m 666 /dev/null    c 1 3

echo "bootstrap: M9 /init reached PID 1"

# --- 1. USB gadget (console + ethernet) for diagnostics ---------------------
if [ -r /usb-gadget.sh ]; then
    . /usb-gadget.sh
    usb_gadget_up && echo "bootstrap: USB gadget up (ttyGS0 + usb0)" || \
        echo "bootstrap: WARNING usb_gadget_up failed" > /dev/console
else
    echo "bootstrap: WARNING /usb-gadget.sh missing" > /dev/console
fi

# --- 2. Locate the system partition by PARTNAME (not fixed p#) -------------
TARGET=
for p in /sys/class/block/mmcblk0p*; do
    n=$(sed -n 's/^PARTNAME=//p' "$p/uevent" 2>/dev/null)
    if [ "$n" = "system" ]; then
        # /sys/class/block/mmcblk0p61 -> /dev/mmcblk0p61
        TARGET=/dev/$(basename "$p")
        break
    fi
done
[ -n "$TARGET" ] || {
    echo "bootstrap: FATAL -- system partition not found (PARTNAME=system)" > /dev/console
    TARGET=
}
[ -n "$TARGET" ] && [ -b "$TARGET" ] || {
    echo "bootstrap: FATAL -- $TARGET is not a block device" > /dev/console
    TARGET=
}

echo "bootstrap: system partition is $TARGET"

# --- 3. Mount system read-only --------------------------------------------
MNT=/mnt/system
mkdir -p "$MNT"
if [ -n "$TARGET" ]; then
    mount -t ext4 "$TARGET" "$MNT" 2>/dev/null || \
        echo "bootstrap: FATAL -- mount $MNT failed (system not formatted ext4?)" > /dev/console
    [ -e "$MNT/sbin/init" ] || \
        echo "bootstrap: FATAL -- $MNT has no /sbin/init" > /dev/console
fi

# --- 4. Hand off (mount --move + switch_root, same as installer) -----------
mkdir -p "$MNT/dev" "$MNT/proc" "$MNT/sys" "$MNT/tmp"
mount --move /dev  "$MNT/dev"   2>/dev/null
mount --move /proc "$MNT/proc"   2>/dev/null
mount --move /sys  "$MNT/sys"   2>/dev/null
mount --move /tmp  "$MNT/tmp"   2>/dev/null

echo "bootstrap: exec switch_root -> $MNT /sbin/init"
exec switch_root "$MNT" /sbin/init

# --- 5. PID 1 must never die --- rescue shell ----------------------------------
echo "bootstrap: FATAL -- switch_root returned; dropping to rescue shell" > /dev/console
while true; do
    [ -e /dev/ttyGS0 ] && /bin/sh < /dev/ttyGS0 > /dev/ttyGS0 2>&1 || /bin/sh
    echo "(rescue shell exited -- respawning)" > /dev/console
    sleep 1
done
