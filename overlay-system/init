#!/bin/busybox-static sh
# /init -- M9 SYSTEM bootstrap (kernel on boot, OS on system, like Android).
#
# This replaces the OS-carrying initramfs. The boot partition now holds ONLY
# the kernel (14.9MB) plus this tiny static bootstrap. It does one job:
#   mount the system partition (p61), then switch_root into it.
# OpenWrt's procd (/sbin/init) then owns the real root. Writable config/
# packages live on /overlay -> userdata (p64) via the rootfs fstab.
#
# Why NOT root= on the cmdline: pack-boot-root.py's appended root= made the
# kernel try to mount the target as root BEFORE /init ran, and it panicked
# (v0.9.4). The donor cmdline is preserved verbatim; /init does the mount.
#
# Why static busybox: OpenWrt's /bin/sh is a symlink to its *dynamic* busybox
# needing the musl loader. If that chain fails before switch_root the kernel
# panics "Requested init /init failed" with no output. A static shell cannot.

mount -t devtmpfs devtmpfs /dev      2>/dev/null

[ -e /dev/console ] || mknod -m 600 /dev/console c 5 1
[ -e /dev/null    ] || mknod -m 666 /dev/null    c 1 3

bootstrap_fatal() {
    echo "bootstrap: FATAL -- $*" > /dev/console
    echo "bootstrap: rescue shell; system handoff stopped" > /dev/console
    while true; do
        [ -e /dev/ttyGS0 ] && /bin/sh < /dev/ttyGS0 > /dev/ttyGS0 2>&1 || /bin/sh
        echo "bootstrap: rescue shell exited -- respawning" > /dev/console
        sleep 1
    done
}

echo "bootstrap: M9 /init reached PID 1" > /dev/console

mount -t proc proc /proc 2>/dev/null || bootstrap_fatal "mount proc failed"
mount -t sysfs sysfs /sys 2>/dev/null || bootstrap_fatal "mount sysfs failed"
mount -t devpts devpts /dev/pts 2>/dev/null || \
    echo "bootstrap: WARNING mount devpts failed" > /dev/console
mount -t tmpfs tmpfs /tmp 2>/dev/null || \
    echo "bootstrap: WARNING mount tmpfs failed" > /dev/console

# --- 1. Start USB gadget setup asynchronously for diagnostics ---------------
if [ -r /usb-gadget.sh ]; then
    (
        . /usb-gadget.sh
        usb_gadget_up
    ) >/dev/null 2>&1 &
    echo "bootstrap: USB gadget setup started (pid=$!)" > /dev/console
else
    echo "bootstrap: WARNING /usb-gadget.sh missing" > /dev/console
fi

# --- 2. Locate the system partition by PARTNAME (not fixed p#) -------------
echo "bootstrap: locating system partition (PARTNAME=system)" > /dev/console
TARGET=
for p in /sys/class/block/mmcblk0p*; do
    n=$(sed -n 's/^PARTNAME=//p' "$p/uevent" 2>/dev/null)
    if [ "$n" = "system" ]; then
        # /sys/class/block/mmcblk0p61 -> /dev/mmcblk0p61
        TARGET=/dev/$(basename "$p")
        break
    fi
done
[ -n "$TARGET" ] || bootstrap_fatal "system partition not found (PARTNAME=system)"
[ -b "$TARGET" ] || bootstrap_fatal "$TARGET is not a block device"

echo "bootstrap: system partition is $TARGET" > /dev/console

# --- 3. Mount system -------------------------------------------------------
MNT=/mnt/system
mkdir -p "$MNT"
mount -t ext4 "$TARGET" "$MNT" 2>/dev/null || \
    bootstrap_fatal "mount $MNT failed (system not formatted ext4?)"

# --- 3b. Staged OTA install (wayne-ota) ------------------------------------
# Runs before the /sbin/init check because the live system staged this update.
# The tarball is verified in RAM first, so a corrupt download can never leave
# the device without a bootable rootfs. The previous tree and boot image are
# kept in RAM for a real rollback if the new tree fails verification.
OTA_FLAG="$MNT/wayne-ota/install.flag"
if [ -f "$OTA_FLAG" ]; then
    echo "bootstrap: OTA staged update detected" > /dev/console
    version=; rootfs_sha256=; boot_sha256=
    . "$OTA_FLAG"
    [ -n "$rootfs_sha256" ] || bootstrap_fatal "OTA: flag has no rootfs_sha256"
    cp "$MNT/wayne-ota/rootfs.tar.gz" /tmp/rootfs.tar.gz || \
        bootstrap_fatal "OTA: cannot copy rootfs to RAM; old system left intact"
    got=$(sha256sum /tmp/rootfs.tar.gz | cut -d' ' -f1)
    [ "$got" = "$rootfs_sha256" ] || \
        bootstrap_fatal "OTA: rootfs checksum mismatch; old system left intact"
    tar -tzf /tmp/rootfs.tar.gz > /tmp/ota.list 2>/dev/null || \
        bootstrap_fatal "OTA: archive unreadable; old system left intact"
    for e in ./sbin/init ./etc/wayne-build.json ./lib/ld-musl-aarch64.so.1; do
        grep -Fxq "$e" /tmp/ota.list || \
            bootstrap_fatal "OTA: archive missing $e; old system left intact"
    done

    echo "bootstrap: OTA verified $version; saving rollback copies" > /dev/console
    tar -czf /tmp/prev-rootfs.tar.gz -C "$MNT" . 2>/dev/null || \
        bootstrap_fatal "OTA: rollback backup failed; old system left intact"
    if [ -f "$MNT/wayne-ota/boot.prev" ]; then
        cp "$MNT/wayne-ota/boot.prev" /tmp/boot.prev
    fi

    echo "bootstrap: OTA replacing system tree" > /dev/console
    rm -rf "$MNT"/* "$MNT"/.[!.]* 2>/dev/null
    if ! tar -xzf /tmp/rootfs.tar.gz -C "$MNT"; then
        echo "bootstrap: OTA extraction failed, rolling back" > /dev/console
        rm -rf "$MNT"/* "$MNT"/.[!.]* 2>/dev/null
        tar -xzf /tmp/prev-rootfs.tar.gz -C "$MNT" 2>/dev/null
        sync
        bootstrap_fatal "OTA extraction failed; previous system restored, reboot required"
    fi
    sync

    if [ ! -x "$MNT/sbin/init" ] || [ ! -e "$MNT/lib/ld-musl-aarch64.so.1" ]; then
        echo "bootstrap: OTA verification failed, rolling back" > /dev/console
        rm -rf "$MNT"/* "$MNT"/.[!.]* 2>/dev/null
        tar -xzf /tmp/prev-rootfs.tar.gz -C "$MNT" 2>/dev/null
        if [ -f /tmp/boot.prev ]; then
            BOOTDEV=
            for p in /sys/class/block/mmcblk0p*; do
                if [ "$(sed -n 's/^PARTNAME=//p' "$p/uevent" 2>/dev/null)" = boot ]; then
                    BOOTDEV=/dev/$(basename "$p"); break
                fi
            done
            [ -n "$BOOTDEV" ] && dd if=/tmp/boot.prev of="$BOOTDEV" bs=1M conv=fsync 2>/dev/null
        fi
        sync
        bootstrap_fatal "OTA tree invalid; previous system and boot restored, reboot required"
    fi

    rm -rf "$MNT/wayne-ota" /tmp/rootfs.tar.gz /tmp/prev-rootfs.tar.gz /tmp/ota.list /tmp/boot.prev
    sync
    echo "bootstrap: OTA $version installed" > /dev/console
fi

[ -x "$MNT/sbin/init" ] || bootstrap_fatal "$MNT has no /sbin/init executable"

echo "bootstrap: system mounted; /sbin/init present" > /dev/console

# --- 3d. Confirm the composite gadget actually bound before we hand over ----
# The gadget is built above in a BACKGROUND subshell. switch_root replaces
# PID 1, and if the binder has not written the UDC yet it is killed mid-build --
# leaving the host with a gadget that enumerates but never configures (no
# ttyGS0 getty, no usb0 carrier). Wait, bounded, for the UDC to reach
# 'configured' before the handoff so the management link survives.
if [ -r /usb-gadget.sh ]; then
    gwait=0; bound=no
    while [ "$gwait" -lt 15 ]; do
        for u in /sys/class/udc/*; do
            [ -e "$u" ] || continue
            case "$(cat "$u/state" 2>/dev/null)" in
                *configured*) bound=yes ;;
            esac
        done
        [ "$bound" = yes ] && break
        sleep 1; gwait=$((gwait+1))
    done
    echo "bootstrap: gadget bound=$bound after ${gwait}s" > /dev/console
fi

# --- 4. Hand off (mount --move + switch_root, same as installer) -----------
mkdir -p "$MNT/dev" "$MNT/proc" "$MNT/sys" "$MNT/tmp"
mount --move /dev  "$MNT/dev"   2>/dev/null || bootstrap_fatal "move /dev failed"
mount --move /proc "$MNT/proc"  2>/dev/null || bootstrap_fatal "move /proc failed"
mount --move /sys  "$MNT/sys"   2>/dev/null || bootstrap_fatal "move /sys failed"
mount --move /tmp  "$MNT/tmp"   2>/dev/null || bootstrap_fatal "move /tmp failed"

echo "bootstrap: switch_root -> $MNT /sbin/init" > /dev/console
# BusyBox requires PID 1. Replace this shell rather than spawning a child.
# Rescue is available for the checked failures above; once exec succeeds,
# an error inside switch_root cannot return to this shell.
exec switch_root "$MNT" /sbin/init
